# ACL 修复留下的备份与回滚脚本，不进版本库
.acl-recovery/

# 临时与探测文件
.probe-*
.tmp/
.tmp-verify/
.tmp2/

# pytest 的临时工作目录放在仓库内：开发环境的系统临时目录长路径形式
# 不被沙箱放行（详见 README「开发环境注意事项」）
.pytest-work*/
.pytest-tmp*/
pytest-cache-files-*/

# 测试素材（用 tests/fixtures/make_fixtures.ps1 在本机生成）
tests/fixtures/media/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行时产物
*.log
*.jsonl
logs/
checkpoints/

# CEP 面板本地调试标记
cep-extension/.debug

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
desktop.ini
